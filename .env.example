# ==============================================================================
# Agentic Transcribe Goal Todolist - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your local environment and fill in your credentials.
# The backend checks configurations in the following priority order:
#   1. TITAN_* (Titan URL + Qwen model per Description.md & AC 3.1)
#   2. AI_LLM_* (Generic OpenAI-compatible provider)
#   3. GEMINI_* (Google Gemini OpenAI-compatible endpoint)
#   4. appsettings.json
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TITAN LLM Provider Configuration (Preferred OpenAI-Compatible LLM)
# ------------------------------------------------------------------------------
# Titan endpoint URL (OpenAI-compatible /v1/chat/completions)
TITAN_LLM_BASE_URL=https://api.titan.example.com/v1

# Model name (e.g., Qwen-2.5-72B-Instruct)
TITAN_LLM_MODEL=qwen-2.5-72b-instruct

# Your Titan API Key
TITAN_API_KEY=your_titan_api_key_here

# ------------------------------------------------------------------------------
# 2. Generic OpenAI-Compatible LLM Provider Fallback
# ------------------------------------------------------------------------------
# Base URL for any OpenAI-compatible API (e.g., vLLM, Ollama, LocalAI, OpenAI)
AI_LLM_BASE_URL=https://api.openai.com/v1

# Target model identifier
AI_LLM_MODEL=gpt-4o-mini

# API key for the OpenAI-compatible service
AI_LLM_API_KEY=your_openai_compatible_api_key_here

# ------------------------------------------------------------------------------
# 3. Google Gemini Provider Fallback
# ------------------------------------------------------------------------------
# Google Gemini OpenAI-compatible REST endpoint
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Google Gemini model (gemini-2.5-flash recommended)
GEMINI_MODEL=gemini-2.5-flash

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Database Persistence Configuration
# ------------------------------------------------------------------------------
# SQLite connection string.
# Read-Write connections use ReadWriteCreate mode;
# AI Query Tool connections physically enforce Mode=ReadOnly and PRAGMA query_only = ON.
ConnectionStrings__DefaultConnection=Data Source=goals.db;Cache=Shared;

# ------------------------------------------------------------------------------
# 5. Backend Server & ASP.NET Core Runtime Configuration
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# ------------------------------------------------------------------------------
# 6. Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
